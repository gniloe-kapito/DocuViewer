{
  "name": "docuviewer",
  "version": "1.0.0",
  "private": true,
  "description": "DocuViewer — клиентский просмотрщик документов (PDF, DOCX, XLSX, PPTX, TXT, Markdown, JSON, RTF, изображения). Всё обрабатывается локально в браузере, файлы не загружаются на сервер.",
  "keywords": [
    "document-viewer",
    "pdf-viewer",
    "docx-viewer",
    "xlsx-viewer",
    "pptx-viewer",
    "client-side",
    "privacy",
    "nextjs",
    "static-export"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "STATIC_EXPORT=1 next build",
    "build:static": "STATIC_EXPORT=1 next build",
    "preview": "bunx serve out --listen 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
